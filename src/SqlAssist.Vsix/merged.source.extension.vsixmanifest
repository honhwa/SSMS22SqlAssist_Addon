<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="SqlAssist.9cc4aed8-f2ad-4120-ba6f-222b08aa04a0" Version="1.5.2" Language="zh-CN" Publisher="SqlAssist" />
    <DisplayName>SqlAssist</DisplayName>
    <Description xml:space="preserve">适用于 SSMS 22 查询编辑器的 IntelliSense 与代码片段：带自动别名的模糊表/列补全、基于外键的 JOIN 建议、按 Tab 展开 SELECT *，以及 Tab 触发的代码片段（ssf → SELECT * FROM）。</Description>
    <Icon>Resources\icon.png</Icon>
    <Tags>SSMS, SQL Server, IntelliSense, Snippets, 中文</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Ssms" Version="[22.0,23.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.8,)" d:Source="Manual" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" DisplayName="Visual Studio core editor" Version="[18.0,19.0)" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" d:Source="Project" d:ProjectName="%CurrentProject%" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="|%CurrentProject%|" d:Source="Project" d:ProjectName="%CurrentProject%" />
  </Assets>
</PackageManifest>