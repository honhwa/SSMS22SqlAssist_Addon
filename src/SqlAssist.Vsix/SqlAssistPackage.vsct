<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidSqlAssistPackage">
    <!-- The "SqlAssist" toolbar (View > Toolbars, or Tools > Customize > Toolbars). -->
    <Menus>
      <Menu guid="guidSqlAssistCmdSet" id="SqlAssistToolbar" type="Toolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>SqlAssist</ButtonText>
          <CommandName>SqlAssist</CommandName>
        </Strings>
      </Menu>
      <!-- Tools > SqlAssist >  — every SqlAssist command in one submenu instead of five Tools items. -->
      <Menu guid="guidSqlAssistCmdSet" id="SqlAssistMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSqlAssistCmdSet" id="ToolsGroup" />
        <Strings>
          <ButtonText>SqlAssist</ButtonText>
          <CommandName>SqlAssist</CommandName>
        </Strings>
      </Menu>
      <!-- Results grid (right-click) > Generate Script As > statement > New Query Window / Clipboard / File. -->
      <Menu guid="guidSqlAssistCmdSet" id="GenerateScriptMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSqlAssistCmdSet" id="GridContextGroup" />
        <Strings>
          <ButtonText>Generate Script As</ButtonText>
          <CommandName>Generate Script As</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidSqlAssistCmdSet" id="ScriptInsertMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSqlAssistCmdSet" id="GenerateScriptGroup" />
        <Strings>
          <ButtonText>INSERT</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidSqlAssistCmdSet" id="ScriptInsertTempTableMenu" priority="0x0101" type="Menu">
        <Parent guid="guidSqlAssistCmdSet" id="GenerateScriptGroup" />
        <Strings>
          <ButtonText>INSERT #tmpTable</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidSqlAssistCmdSet" id="ScriptWhereInMenu" priority="0x0102" type="Menu">
        <Parent guid="guidSqlAssistCmdSet" id="GenerateScriptGroup" />
        <Strings>
          <ButtonText>WHERE IN()</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidSqlAssistCmdSet" id="ScriptWhereAndOrMenu" priority="0x0103" type="Menu">
        <Parent guid="guidSqlAssistCmdSet" id="GenerateScriptGroup" />
        <Strings>
          <ButtonText>WHERE AND OR</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidSqlAssistCmdSet" id="ScriptUpdateMenu" priority="0x0104" type="Menu">
        <Parent guid="guidSqlAssistCmdSet" id="GenerateScriptGroup" />
        <Strings>
          <ButtonText>UPDATE</ButtonText>
        </Strings>
      </Menu>
    </Menus>
    <Groups>
      <Group guid="guidSqlAssistCmdSet" id="ToolsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="SubmenuGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCmdSet" id="SqlAssistMenu" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="ToolbarGroup" priority="0x0000">
        <Parent guid="guidSqlAssistCmdSet" id="SqlAssistToolbar" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="GridContextGroup" priority="0x0600">
        <Parent guid="guidSqlEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="EditorContextGroup" priority="0x0600">
        <Parent guid="guidSqlEditorGroup" id="IDM_SQLWB_SQLSCRIPT_CONTEXT" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="GenerateScriptGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCmdSet" id="GenerateScriptMenu" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="ScriptInsertGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptInsertMenu" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="ScriptInsertTempTableGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptInsertTempTableMenu" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="ScriptWhereInGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptWhereInMenu" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="ScriptWhereAndOrGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptWhereAndOrMenu" />
      </Group>
      <Group guid="guidSqlAssistCmdSet" id="ScriptUpdateGroup" priority="0x0100">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptUpdateMenu" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidSqlAssistCmdSet" id="cmdRefreshSchema" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="SubmenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Refresh" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Refresh Schema Cache</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdEditSnippets" priority="0x0101" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="SubmenuGroup" />
        <Strings>
          <ButtonText>Edit Snippets...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdAbout" priority="0x0110" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="SubmenuGroup" />
        <Strings>
          <ButtonText>About...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdCheckUpdates" priority="0x0103" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="SubmenuGroup" />
        <Strings>
          <ButtonText>Check for Updates...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdClipboardToSql" priority="0x009A" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="SubmenuGroup" />
        <Strings>
          <ButtonText>CSV to SQL...</ButtonText>
          <ToolTipText>Turn cells copied from Excel, or CSV text, into IN (...), VALUES (...) or a #Temp table with INSERT</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdFormatSql" priority="0x009B" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="SubmenuGroup" />
        <Strings>
          <ButtonText>Format SQL</ButtonText>
          <CommandName>SqlAssist.FormatSql</CommandName>
          <ToolTipText>Format the selection, or the whole query window when nothing is selected (Ctrl+K, Ctrl+Shift+F)</ToolTipText>
        </Strings>
      </Button>
      <!-- The query editor's right-click copy of Format SQL. A command has one ButtonText, so it is a second command with the
           same handler; the text says SqlAssist because SSMS 22 has a Format SQL of its own (Ctrl+K, Ctrl+Q). -->
      <Button guid="guidSqlAssistCmdSet" id="cmdFormatSqlContext" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="EditorContextGroup" />
        <Strings>
          <ButtonText>Format SQL (SqlAssist)</ButtonText>
          <CommandName>SqlAssist.FormatSqlContext</CommandName>
          <ToolTipText>Format the selection, or the whole query window when nothing is selected (Ctrl+K, Ctrl+Shift+F)</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdCheckRisks" priority="0x009C" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="SubmenuGroup" />
        <Strings>
          <ButtonText>Check SQL Risks...</ButtonText>
          <CommandName>SqlAssist.CheckSqlRisks</CommandName>
          <ToolTipText>List UPDATE / DELETE without WHERE, TRUNCATE TABLE and DROP TABLE in the selection (or the whole query window); nothing is changed or run</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdOptions" priority="0x0105" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="SubmenuGroup" />
        <Strings>
          <ButtonText>Options...</ButtonText>
          <ToolTipText>SqlAssist settings: Format SQL and Check SQL Risks</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdSearch" priority="0x0099" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="SubmenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Search" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <!-- Icon and text on the toolbar; the menu shows the text either way. -->
        <CommandFlag>IconAndText</CommandFlag>
        <Strings>
          <ButtonText>Search Objects...</ButtonText>
          <ToolTipText>Search database objects (SqlAssist)</ToolTipText>
        </Strings>
      </Button>
      <!-- The toolbar's own Search button: the SqlAssist logo and a short label. A command has one ButtonText,
           so it is a second command with the same handler rather than a placement of cmdSearch. -->
      <Button guid="guidSqlAssistCmdSet" id="cmdSearchToolbar" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ToolbarGroup" />
        <!-- An image moniker from SqlAssist.imagemanifest (16/24/32/48 px), not a <Bitmaps> strip: a single
             16x16 bitmap is stretched and blurred on high-DPI displays. -->
        <Icon guid="guidSqlAssistImages" id="bmpLogo" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>IconAndText</CommandFlag>
        <Strings>
          <ButtonText>SqlAssist</ButtonText>
          <ToolTipText>SqlAssist: Search Objects</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptInsertNewWindow" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptInsertGroup" />
        <Strings>
          <ButtonText>New Query Window</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptInsertClipboard" priority="0x0101" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptInsertGroup" />
        <Strings>
          <ButtonText>Clipboard</ButtonText>
          <ToolTipText>Copy the INSERT script (Ctrl+J, I in the results grid)</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptInsertFile" priority="0x0102" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptInsertGroup" />
        <Strings>
          <ButtonText>File...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptInsertTempTableNewWindow" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptInsertTempTableGroup" />
        <Strings>
          <ButtonText>New Query Window</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptInsertTempTableClipboard" priority="0x0101" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptInsertTempTableGroup" />
        <Strings>
          <ButtonText>Clipboard</ButtonText>
          <ToolTipText>Copy the INSERT #tmpTable script (Ctrl+J, T in the results grid)</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptInsertTempTableFile" priority="0x0102" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptInsertTempTableGroup" />
        <Strings>
          <ButtonText>File...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptWhereInNewWindow" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptWhereInGroup" />
        <Strings>
          <ButtonText>New Query Window</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptWhereInClipboard" priority="0x0101" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptWhereInGroup" />
        <Strings>
          <ButtonText>Clipboard</ButtonText>
          <ToolTipText>Copy the WHERE IN() script (Ctrl+J, W in the results grid)</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptWhereInFile" priority="0x0102" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptWhereInGroup" />
        <Strings>
          <ButtonText>File...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptWhereAndOrNewWindow" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptWhereAndOrGroup" />
        <Strings>
          <ButtonText>New Query Window</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptWhereAndOrClipboard" priority="0x0101" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptWhereAndOrGroup" />
        <Strings>
          <ButtonText>Clipboard</ButtonText>
          <ToolTipText>Copy the WHERE AND OR script (Ctrl+J, O in the results grid)</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptWhereAndOrFile" priority="0x0102" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptWhereAndOrGroup" />
        <Strings>
          <ButtonText>File...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptUpdateNewWindow" priority="0x0100" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptUpdateGroup" />
        <Strings>
          <ButtonText>New Query Window...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptUpdateClipboard" priority="0x0101" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptUpdateGroup" />
        <Strings>
          <ButtonText>Clipboard...</ButtonText>
          <ToolTipText>Choose the table and key columns, then copy the UPDATE script (Ctrl+J, U in the results grid)</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSqlAssistCmdSet" id="cmdScriptUpdateFile" priority="0x0102" type="Button">
        <Parent guid="guidSqlAssistCmdSet" id="ScriptUpdateGroup" />
        <Strings>
          <ButtonText>File...</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- Refresh Schema Cache also sits on the toolbar, after the Search button. -->
  <CommandPlacements>
    <CommandPlacement guid="guidSqlAssistCmdSet" id="cmdRefreshSchema" priority="0x0200">
      <Parent guid="guidSqlAssistCmdSet" id="ToolbarGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <!-- Ctrl+K, Ctrl+Shift+F in text editors. Checked against Visual Studio's default shortcut list, SSMS 22's own profile
       (its built-in Format SQL is Ctrl+K, Ctrl+Q; Copilot uses Ctrl+Alt+E/R/D/F) and SqlAssist's keys: nothing else uses it. -->
  <KeyBindings>
    <KeyBinding guid="guidSqlAssistCmdSet" id="cmdFormatSql" editor="guidTextEditorScope" key1="K" mod1="Control" key2="F" mod2="Control Shift" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidSqlAssistPackage" value="{9cc4aed8-f2ad-4120-ba6f-222b08aa04a0}" />
    <GuidSymbol name="guidSqlAssistCmdSet" value="{545a3b92-0849-4527-8c0a-effa65b4e0c1}">
      <IDSymbol name="ToolsGroup" value="0x1020" />
      <IDSymbol name="ToolbarGroup" value="0x1021" />
      <IDSymbol name="SqlAssistToolbar" value="0x1030" />
      <IDSymbol name="SqlAssistMenu" value="0x1031" />
      <IDSymbol name="SubmenuGroup" value="0x1022" />
      <IDSymbol name="cmdRefreshSchema" value="0x0100" />
      <IDSymbol name="cmdEditSnippets" value="0x0101" />
      <IDSymbol name="cmdAbout" value="0x0103" />
      <IDSymbol name="cmdSearch" value="0x0104" />
      <IDSymbol name="cmdSearchToolbar" value="0x0105" />
      <IDSymbol name="cmdCheckUpdates" value="0x0106" />
      <IDSymbol name="cmdClipboardToSql" value="0x0107" />
      <IDSymbol name="cmdFormatSql" value="0x0108" />
      <IDSymbol name="cmdOptions" value="0x0109" />
      <IDSymbol name="cmdCheckRisks" value="0x010A" />
      <IDSymbol name="cmdFormatSqlContext" value="0x010B" />
      <IDSymbol name="EditorContextGroup" value="0x1043" />
      <IDSymbol name="GridContextGroup" value="0x1040" />
      <IDSymbol name="GenerateScriptMenu" value="0x1041" />
      <IDSymbol name="GenerateScriptGroup" value="0x1042" />
      <IDSymbol name="ScriptInsertMenu" value="0x1050" />
      <IDSymbol name="ScriptInsertGroup" value="0x1060" />
      <IDSymbol name="cmdScriptInsertNewWindow" value="0x0200" />
      <IDSymbol name="cmdScriptInsertClipboard" value="0x0201" />
      <IDSymbol name="cmdScriptInsertFile" value="0x0202" />
      <IDSymbol name="ScriptInsertTempTableMenu" value="0x1051" />
      <IDSymbol name="ScriptInsertTempTableGroup" value="0x1061" />
      <IDSymbol name="cmdScriptInsertTempTableNewWindow" value="0x0210" />
      <IDSymbol name="cmdScriptInsertTempTableClipboard" value="0x0211" />
      <IDSymbol name="cmdScriptInsertTempTableFile" value="0x0212" />
      <IDSymbol name="ScriptWhereInMenu" value="0x1052" />
      <IDSymbol name="ScriptWhereInGroup" value="0x1062" />
      <IDSymbol name="cmdScriptWhereInNewWindow" value="0x0220" />
      <IDSymbol name="cmdScriptWhereInClipboard" value="0x0221" />
      <IDSymbol name="cmdScriptWhereInFile" value="0x0222" />
      <IDSymbol name="ScriptWhereAndOrMenu" value="0x1053" />
      <IDSymbol name="ScriptWhereAndOrGroup" value="0x1063" />
      <IDSymbol name="cmdScriptWhereAndOrNewWindow" value="0x0230" />
      <IDSymbol name="cmdScriptWhereAndOrClipboard" value="0x0231" />
      <IDSymbol name="cmdScriptWhereAndOrFile" value="0x0232" />
      <IDSymbol name="ScriptUpdateMenu" value="0x1054" />
      <IDSymbol name="ScriptUpdateGroup" value="0x1064" />
      <IDSymbol name="cmdScriptUpdateNewWindow" value="0x0240" />
      <IDSymbol name="cmdScriptUpdateClipboard" value="0x0241" />
      <IDSymbol name="cmdScriptUpdateFile" value="0x0242" />
    </GuidSymbol>
    <!-- SSMS's own results-grid and query-editor context menus (SQLEditors' SQLWorkbenchCommands.GUID_SQLEditorGroup /
         IDM_SQLWB_SQLRESGRID_CONTEXT = 112 and IDM_SQLWB_SQLSCRIPT_CONTEXT = 80). -->
    <GuidSymbol name="guidSqlEditorGroup" value="{33F13AC3-80BB-4ECB-85BC-225435603A5E}">
      <IDSymbol name="IDM_SQLWB_SQLRESGRID_CONTEXT" value="0x0070" />
      <IDSymbol name="IDM_SQLWB_SQLSCRIPT_CONTEXT" value="0x0050" />
    </GuidSymbol>
    <!-- The "Text Editor" key-binding scope (the same GUID as Visual Studio's text editor command set). -->
    <GuidSymbol name="guidTextEditorScope" value="{8B382828-6202-11D1-8870-0000F87579D2}" />
    <GuidSymbol name="guidSqlAssistImages" value="{b3f1c6e2-5a47-4d8e-9c21-7e4a0d9f3b58}">
      <!-- Same Guid and ID as in SqlAssist.imagemanifest. -->
      <IDSymbol name="bmpLogo" value="1" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
