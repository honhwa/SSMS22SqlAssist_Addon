<Project Sdk="Microsoft.NET.Sdk">
  <!-- SqlAssistSetup.exe: a setup window that carries the .vsix and installs, updates or removes it in SSMS 22.
       .NET Framework 4.8 ships with Windows 10/11, so the exe runs without installing a runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SqlAssistSetup</AssemblyName>
    <RootNamespace>SqlAssist.Setup</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from assets\icon.png by make-icons.ps1. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <VsixPath>..\SqlAssist.Vsix\bin\$(Configuration)\net48\SqlAssist.vsix</VsixPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- The logo in the window header. -->
    <EmbeddedResource Include="..\SqlAssist.Vsix\Resources\icon.png" LogicalName="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the extension first; the exe only needs its .vsix, not its assembly. -->
    <ProjectReference Include="..\SqlAssist.Vsix\SqlAssist.Vsix.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- The .vsix comes from the referenced project, and MSBuild builds project references in ResolveReferences, which
       runs AFTER PrepareForBuild. Hanging this off PrepareForBuild therefore checks for the file before the Vsix
       project has ever been built: a clean tree (no .vsix yet) failed here instead of building the extension first.
       PrepareResources is the first target that actually needs the embedded resource, and it runs after
       ResolveReferences, so by then the .vsix exists. -->
  <Target Name="EmbedVsix" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResources">
    <Error Condition="!Exists('$(VsixPath)')" Text="$(VsixPath) not found. Build the whole solution (or src\SqlAssist.Vsix first), then build this project again (Configuration=$(Configuration))." />
    <ItemGroup>
      <EmbeddedResource Include="$(VsixPath)" LogicalName="SqlAssist.vsix" />
    </ItemGroup>
  </Target>
</Project>
